# ============================================
# Vivaan — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ============================================

# ────────────────────────────────────────────
# DATABASE (Supabase Postgres)
# ────────────────────────────────────────────
# Get this from Supabase Dashboard → Settings → Database → Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# ────────────────────────────────────────────
# SUPABASE (Storage + Auth)
# ────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SERVER-ONLY — never expose to client!)
# Dashboard → Settings → API → service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: alias for anon key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Storage bucket name (must be created in Supabase Dashboard first)
# Default: "media"
SUPABASE_STORAGE_BUCKET=media

# ────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────
# Your deployed site URL (used for redirects, emails, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────
# ADMIN ACCOUNT (seeded on first run)
# ────────────────────────────────────────────
# These are used by src/db/seed.ts on first database init.
# The password is bcrypt-hashed before storage.
# You can change these, but the defaults are:
# Email: admin@vivaan.com
# Password: Vivaan@Secure2026

# ────────────────────────────────────────────
# SUPABASE SETUP CHECKLIST
# ────────────────────────────────────────────
# 1. Create a Supabase project at https://supabase.com
# 2. Copy DATABASE_URL from Settings → Database → Connection string
# 3. Copy NEXT_PUBLIC_SUPABASE_URL and anon key from Settings → API
# 4. Copy SUPABASE_SERVICE_ROLE_KEY from Settings → API (keep secret!)
# 5. Go to Storage → Create bucket named "media" (public, 50MB limit)
# 6. Run schema push: npx drizzle-kit push
# 7. Seed the database: curl -X POST http://localhost:3000/api/seed
# 8. Login at /admin/login with admin@vivaan.com / Vivaan@Secure2026
